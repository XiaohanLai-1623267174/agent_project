# 复制为 .env 放进【服务端代码目录】（server/），填入你自己的密钥。
# 本文件只是模板：任何真实 key 都不要提交。

# --- 阿里云百炼：embedding（必须）；rerank 可用它或本地 ---
QW_API_KEY=

# --- 魔搭 ModelScope：chat / classify / rewrite / answer / title 等角色 ---
MS_API_KEY=
MS_API_KEY_2=

# --- 商汤 SenseNova：备用 ---
SENSENOVA_API_KEY=

# --- 鉴权：不设则用代码里的占位默认值（生产必须改）---
JWT_SECRET=

# --- 重排：local 用 rerank_server.py（0 云端 token）/ cloud 走百炼 / off 关闭 ---
RERANK_BACKEND=local
RERANK_LOCAL_URL=http://127.0.0.1:8090
# 本地重排模型目录（bge-reranker-v2-m3）；不设则找 rerank/models/bge-reranker-v2-m3
RERANK_MODEL_PATH=

# --- 多个 .env 时的显式覆盖（os.pathsep 分隔；一般不用设）---
# DSH_ENV_FILES=
